# =============================================================================
# Local development env example
# cp config/local.env.example .env
# =============================================================================

NODE_ENV=development
PORT=4000

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

CORS_ORIGINS=http://localhost:8081,http://localhost:8085,http://localhost:19006
SESSION_SECRET=dev_only_change_me
LOG_LEVEL=debug
