# =============================================================================
# Render — Backend (Web Service / Node API) env example
# Dashboard: Render -> your service -> Environment
# Or Blueprint: render.yaml + this file as reference
# =============================================================================

# --- Runtime ---
NODE_ENV=production
PORT=10000
# Render sets PORT automatically; keep a local default for Docker/dev

# --- Public URLs ---
APP_PUBLIC_URL=https://YOUR_NETLIFY_SITE.netlify.app
API_PUBLIC_URL=https://YOUR_RENDER_SERVICE.onrender.com
CORS_ORIGINS=https://YOUR_NETLIFY_SITE.netlify.app,http://localhost:8081,http://localhost:8085

# --- Supabase (server) ---
# Project: https://supabase.com/dashboard/project/YOUR_PROJECT_REF
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
# service_role: Settings -> API -> service_role (NEVER expose to frontend / Netlify)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Optional DB direct connection (only if backend talks to Postgres directly)
# Prefer pooler URL for Render free/low tier
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- Auth / sessions (when you add custom JWT cookie API) ---
SESSION_SECRET=replace_with_long_random_string
JWT_EXPIRES_IN=7d

# --- Feature flags / app config ---
DEFAULT_BRANCH_CODE=hongdae
RESERVATION_TIMEZONE=Asia/Seoul
FEED_DEFAULT_TAB=recommend
ENABLE_PUSH_NOTIFICATIONS=false

# --- Storage (booth originals / shorts uploads) ---
SUPABASE_STORAGE_BUCKET_ORIGINALS=studio-originals
SUPABASE_STORAGE_BUCKET_SHORTS=user-shorts
MAX_UPLOAD_MB=512

# --- External media / CDN (optional) ---
CDN_BASE_URL=
VIDEO_TRANSCODE_WEBHOOK_SECRET=

# --- Observability (optional) ---
LOG_LEVEL=info
SENTRY_DSN=
