# =============================================================================
# Netlify — Frontend (Expo Web / static export) env example
# Dashboard: Site settings -> Environment variables
# Build must expose EXPO_PUBLIC_* at build time for Expo web.
# =============================================================================

NODE_VERSION=22

# Supabase (public / anon only — never put service_role here)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# Render API base
EXPO_PUBLIC_API_BASE_URL=https://YOUR_RENDER_SERVICE.onrender.com

# App
EXPO_PUBLIC_APP_NAME=SCENE HAUS
EXPO_PUBLIC_DEFAULT_BRANCH_CODE=hongdae

# Optional analytics
EXPO_PUBLIC_SENTRY_DSN=
