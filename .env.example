# =============================================================================
# SCENE HAUS — environment template overview
# Copy the file you need, fill values, never commit real secrets.
#
# Planned stack
#   Frontend (Expo Web) -> Netlify
#   Backend  (API)      -> Render
#   Database            -> Supabase
# =============================================================================

# --- Shared / client-safe (can also go on Netlify) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
EXPO_PUBLIC_API_BASE_URL=https://YOUR_RENDER_SERVICE.onrender.com

# --- Render backend only (server secrets) ---
# See config/render.env.example
